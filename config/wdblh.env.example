# Copy to config/wdblh.env, then edit. This is a trusted Bash configuration file.
# Explicit exported WDBLH_* environment variables override this file.
# No local usernames, keys, passwords or device authorizations belong in Git.

# Required for boot/service: existing non-root account for the HTTPS bridge.
# Manual sudo launch defaults to SUDO_USER; installer records the selected account.
# WDBLH_BRIDGE_USER=robot

# WDBLH_PROJECT=/absolute/path/to/wdblh
# WDBLH_CONTROL_BIN=/absolute/path/to/wdblh/cmake_build_cpu/bin/rl_real_wdblh
# WDBLH_POLICY_DIR=/absolute/path/to/wdblh/policy
# WDBLH_LOG_DIR=/absolute/path/to/wdblh/logs
# WDBLH_BOOT_LOG=/absolute/path/to/wdblh/logs/boot.log
# WDBLH_BRIDGE_LOG=/absolute/path/to/wdblh/logs/bridge.log
# WDBLH_CONTROL_LOG=/absolute/path/to/wdblh/logs/controller.log

# Explicit ports override udev/sysfs detection. Defaults detect first, then use
# /dev/ttyACM0 and /dev/ttyCH343USB0 if no matching device is present.
# WDBLH_IMU_PORT=/dev/wdblh_imu
# WDBLH_MOTOR_PORT=/dev/wdblh_motor
WDBLH_IMU_BAUD=921600
WDBLH_MOTOR_BAUD=4000000

# Original CPU affinity: 4 for control, 5 for inference. Set -1 to disable binding.
# Confirm CPU availability/cpuset on the destination before real deployment.
WDBLH_CONTROL_CPU=4
WDBLH_RL_CPU=5

WDBLH_BRIDGE_BIND=0.0.0.0
WDBLH_BRIDGE_PORT=8443
# Optional advertised IP/hostname, otherwise detected automatically.
# WDBLH_BRIDGE_HOST=192.168.1.23
# Optional NIC for IP discovery; unset means no dependency on a fixed NIC name.
# WDBLH_NETWORK_INTERFACE=wlan0
# WDBLH_CERT_DIR=/absolute/path/to/private/certs

# Installed vendor runtime paths, if required. Avoid copying libraries across CPUs.
# WDBLH_LIBRARY_PATH=/usr/local/lib
# ADSP_LIBRARY_PATH=/vendor/sdk/dsp/path
